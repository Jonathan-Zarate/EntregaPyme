generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum CompanyMemberRole {
  OWNER
  OPERATOR
}

enum CourierApprovalStatus {
  PENDING
  APPROVED
  BLOCKED
  REJECTED
}

enum TopUpStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WalletTransactionType {
  TOP_UP
  RESERVE
  RELEASE
  CAPTURE
  ADJUSTMENT
}

enum OrderStatus {
  DRAFT
  PENDING_ASSIGNMENT
  ACCEPTED
  HEADING_TO_PICKUP
  PICKED_UP
  HEADING_TO_DESTINATION
  DELIVERED
  CANCELLED
}

enum PackageType {
  DOCUMENT
  SMALL
  MEDIUM
  LARGE
  OTHER
}

enum OfferStatus {
  AVAILABLE
  ACCEPTED
  REJECTED
  EXPIRED
}

enum EvidenceType {
  PHOTO
  COMMENT
}

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?
  role          String     @default("COMPANY")
  status        UserStatus @default(ACTIVE)
  banned        Boolean    @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  sessions              Session[]
  accounts              Account[]
  companyMemberships    CompanyMember[]
  courierProfile        CourierProfile?
  reviewedCouriers      CourierProfile[]      @relation("CourierReviewedBy")
  reviewedTopUps        TopUp[]                @relation("TopUpReviewedBy")
  assignedOrders        DeliveryOrder[]        @relation("OrderAssignedBy")
  createdOrders         DeliveryOrder[]        @relation("OrderCreatedBy")
  orderStatusEvents     OrderStatusEvent[]
  deliveryEvidence      DeliveryEvidence[]
  auditLogs             AuditLog[]

  @@index([role, status])
}

model Session {
  id             String   @id @default(cuid())
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Company {
  id             String   @id @default(cuid())
  ruc            String   @unique @db.VarChar(11)
  legalName      String
  tradeName      String?
  phone          String?  @db.VarChar(20)
  pickupAddress  String?
  pickupReference String?
  districtId     String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  district       District?        @relation(fields: [districtId], references: [id])
  members        CompanyMember[]
  wallet         Wallet?
  topUps         TopUp[]
  orders         DeliveryOrder[]

  @@index([districtId])
  @@index([active])
}

model CompanyMember {
  id        String            @id @default(cuid())
  companyId String
  userId    String
  role      CompanyMemberRole @default(OPERATOR)
  createdAt DateTime          @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
}

model CourierProfile {
  id                String                  @id @default(cuid())
  userId            String                  @unique
  documentType      String                  @db.VarChar(10)
  documentNumber    String                  @unique @db.VarChar(20)
  phone             String                  @db.VarChar(20)
  vehiclePlate      String?                 @db.VarChar(10)
  approvalStatus    CourierApprovalStatus   @default(PENDING)
  reviewedAt        DateTime?
  reviewedById      String?
  reviewReason      String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy        User?                   @relation("CourierReviewedBy", fields: [reviewedById], references: [id])
  assignedOrders    DeliveryOrder[]          @relation("AssignedCourier")
  offers            OrderOffer[]
  evidence          DeliveryEvidence[]

  @@index([approvalStatus])
  @@index([reviewedById])
}

model District {
  id         String   @id @default(cuid())
  ubigeo     String   @unique @db.VarChar(6)
  name       String
  province   String
  department String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  companies       Company[]
  originRates     DeliveryRate[]  @relation("RateOrigin")
  destinationRates DeliveryRate[] @relation("RateDestination")
  pickupOrders    DeliveryOrder[] @relation("OrderPickupDistrict")
  deliveryOrders  DeliveryOrder[] @relation("OrderDeliveryDistrict")

  @@index([department, province, name])
  @@index([active])
}

model DeliveryRate {
  id                    String   @id @default(cuid())
  originDistrictId      String
  destinationDistrictId String
  companyPrice          Decimal  @db.Decimal(12, 2)
  courierPayment        Decimal  @db.Decimal(12, 2)
  active                Boolean  @default(true)
  validFrom             DateTime @default(now())
  validUntil            DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  originDistrict      District @relation("RateOrigin", fields: [originDistrictId], references: [id])
  destinationDistrict District @relation("RateDestination", fields: [destinationDistrictId], references: [id])
  orders              DeliveryOrder[]

  @@unique([originDistrictId, destinationDistrictId, validFrom])
  @@index([originDistrictId, destinationDistrictId, active])
}

model Wallet {
  id                String   @id @default(cuid())
  companyId         String   @unique
  availableBalance  Decimal  @default(0) @db.Decimal(14, 2)
  reservedBalance   Decimal  @default(0) @db.Decimal(14, 2)
  version           Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company      Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  transactions WalletTransaction[]

  @@index([companyId, version])
}

model WalletTransaction {
  id             String                @id @default(cuid())
  walletId       String
  type           WalletTransactionType
  amount         Decimal               @db.Decimal(14, 2)
  availableAfter Decimal               @db.Decimal(14, 2)
  reservedAfter  Decimal               @db.Decimal(14, 2)
  orderId        String?
  topUpId        String?
  idempotencyKey String                @unique
  description    String?
  createdAt      DateTime              @default(now())

  wallet Wallet         @relation(fields: [walletId], references: [id], onDelete: Restrict)
  order  DeliveryOrder? @relation(fields: [orderId], references: [id])
  topUp  TopUp?         @relation(fields: [topUpId], references: [id])

  @@index([walletId, createdAt])
  @@index([orderId])
  @@index([topUpId])
}

model TopUp {
  id             String      @id @default(cuid())
  companyId      String
  amount         Decimal     @db.Decimal(14, 2)
  status         TopUpStatus @default(PENDING)
  operationCode  String?
  evidenceUrl    String?
  requestedAt    DateTime    @default(now())
  reviewedAt     DateTime?
  reviewedById   String?
  reviewReason   String?

  company      Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  reviewedBy   User?               @relation("TopUpReviewedBy", fields: [reviewedById], references: [id])
  transactions WalletTransaction[]

  @@index([companyId, status, requestedAt])
  @@index([reviewedById])
  @@unique([companyId, operationCode])
}

model DeliveryOrder {
  id                    String       @id @default(cuid())
  publicCode            String       @unique
  companyId             String
  createdById           String
  rateId                 String
  assignedCourierId     String?
  assignedById          String?
  status                OrderStatus  @default(DRAFT)
  pickupDistrictId      String
  pickupAddress         String
  pickupReference       String?
  deliveryDistrictId    String
  deliveryAddress       String
  deliveryReference     String?
  recipientName         String
  recipientPhone        String       @db.VarChar(20)
  packageType           PackageType
  packageDescription    String?
  observations          String?
  companyPrice          Decimal      @db.Decimal(12, 2)
  courierPayment        Decimal      @db.Decimal(12, 2)
  platformMargin        Decimal      @db.Decimal(12, 2)
  confirmedAt           DateTime?
  assignedAt            DateTime?
  pickedUpAt            DateTime?
  deliveredAt           DateTime?
  cancelledAt           DateTime?
  cancellationReason    String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  company             Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy           User            @relation("OrderCreatedBy", fields: [createdById], references: [id])
  rate                DeliveryRate    @relation(fields: [rateId], references: [id])
  assignedCourier     CourierProfile? @relation("AssignedCourier", fields: [assignedCourierId], references: [id])
  assignedBy          User?           @relation("OrderAssignedBy", fields: [assignedById], references: [id])
  pickupDistrict      District        @relation("OrderPickupDistrict", fields: [pickupDistrictId], references: [id])
  deliveryDistrict    District        @relation("OrderDeliveryDistrict", fields: [deliveryDistrictId], references: [id])
  statusEvents        OrderStatusEvent[]
  offers              OrderOffer[]
  evidence            DeliveryEvidence[]
  walletTransactions  WalletTransaction[]

  @@index([companyId, createdAt])
  @@index([status, createdAt])
  @@index([assignedCourierId, status])
  @@index([pickupDistrictId, deliveryDistrictId, status])
}

model OrderOffer {
  id          String      @id @default(cuid())
  orderId     String
  courierId   String
  status      OfferStatus @default(AVAILABLE)
  respondedAt DateTime?
  createdAt   DateTime    @default(now())

  order   DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier CourierProfile @relation(fields: [courierId], references: [id], onDelete: Cascade)

  @@unique([orderId, courierId])
  @@index([courierId, status, createdAt])
}

model OrderStatusEvent {
  id        String      @id @default(cuid())
  orderId   String
  fromStatus OrderStatus?
  toStatus  OrderStatus
  actorId   String
  actorRole String
  comment   String?
  createdAt DateTime    @default(now())

  order DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User          @relation(fields: [actorId], references: [id])

  @@index([orderId, createdAt])
  @@index([actorId, createdAt])
}

model DeliveryEvidence {
  id        String       @id @default(cuid())
  orderId   String
  courierId String
  actorId   String
  type      EvidenceType
  url       String?
  comment   String?
  createdAt DateTime     @default(now())

  order   DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier CourierProfile @relation(fields: [courierId], references: [id])
  actor   User           @relation(fields: [actorId], references: [id])

  @@index([orderId, createdAt])
  @@index([courierId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}
